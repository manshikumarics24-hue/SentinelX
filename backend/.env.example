# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# NeonTech / PostgreSQL Database Connection URL
# Replace with your Neon connection string:
# postgresql://<user>:<password>@<ep-hostname>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# OpenAI API Key (Optional — fallback rule-based SOC engine activates if absent)
OPENAI_API_KEY=your_openai_api_key_here
